new file mode 100644
index 0000000..2155a02
--- /dev/null
+++ b/tests/test_report.py
@@ -0,0 +1,22 @@
+from ledger.report import format_totals
+from ledger.accounts import Ledger
+
+
+def _fill(currency: str, cents: int) -> Ledger:
+    lg = Ledger()
+    acc = lg.open("a", currency)
+    from ledger.money import Money
+    acc.post(Money(cents, currency))
+    return lg
+
+
+def test_format_totals_sorted():
+    lg = Ledger()
+    from ledger.money import Money
+    lg.open("usd", "USD").post(Money(1050, "USD"))
+    lg.open("eur", "EUR").post(Money(-5, "EUR"))
+    assert format_totals(lg) == "EUR: -0.05 EUR\nUSD: 10.50 USD"
+
+
+def test_format_totals_empty():
+    assert format_totals(Ledger()) == ""
