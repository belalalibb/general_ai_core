 from __future__ import annotations
 
 from ledger.accounts import Ledger
+from ledger.money import Money
 
 
 def balances_report(ledger: Ledger) -> str:
@@ -17,3 +18,12 @@ def totals_by_currency(ledger: Ledger) -> dict[str, int]:
     for account in ledger.accounts():
         totals[account.currency] = totals.get(account.currency, 0) + account.balance().cents
     return totals
+
+
+def format_totals(ledger: Ledger) -> str:
+    """Return one line per currency 'CUR: <amount>' sorted by currency code."""
+    totals = totals_by_currency(ledger)
+    lines = []
+    for cur in sorted(totals):
+        lines.append(f"{cur}: {Money(totals[cur], cur)}")
+    return "\n".join(lines)
