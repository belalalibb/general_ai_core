+                ErrorCategory.INVALID_CREDENTIAL,
+                "provider rejected the credential",
+                provider_code=reply.error_code,
+            ),
+        )
     category = _HTTP_STATUS_MAP.get(status, ErrorCategory.NON_RETRYABLE_ERROR)
